# ==============================================================================
# FreightGuard AI Enterprise - OAuth 2.0 & Production Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your actual developer credentials.
# In Streamlit Cloud, add these exact keys in App Settings -> Secrets.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Live Base URL (used for OAuth redirect callbacks)
# Local development: http://localhost:8501 (or http://127.0.0.1:8000 for REST API)
# Production Streamlit Cloud: https://luffy-2601-yottaflex-ai-app-rvlcha.streamlit.app
APP_URL=https://luffy-2601-yottaflex-ai-app-rvlcha.streamlit.app
DATABASE_URL=sqlite:///data/freight_audit.db
SESSION_SECRET=generate_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 / OPENID CONNECT
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   - https://luffy-2601-yottaflex-ai-app-rvlcha.streamlit.app
#   - http://127.0.0.1:8000/auth/google/callback (for REST API)
#   - http://localhost:8501 (for local Streamlit)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 3. GITHUB OAUTH APPLICATION
# ------------------------------------------------------------------------------
# Obtain from GitHub Developer Settings: https://github.com/settings/developers
# Authorized callback URL:
#   - https://luffy-2601-yottaflex-ai-app-rvlcha.streamlit.app
#   - http://127.0.0.1:8000/auth/github/callback (for REST API)
#   - http://localhost:8501 (for local Streamlit)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ------------------------------------------------------------------------------
# 4. META FACEBOOK LOGIN
# ------------------------------------------------------------------------------
# Obtain from Meta for Developers: https://developers.facebook.com/apps
# Valid OAuth Redirect URIs:
#   - https://luffy-2601-yottaflex-ai-app-rvlcha.streamlit.app
#   - http://127.0.0.1:8000/auth/facebook/callback (for REST API)
#   - http://localhost:8501 (for local Streamlit)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ------------------------------------------------------------------------------
# 5. X (TWITTER) OAUTH 2.0 WITH PKCE
# ------------------------------------------------------------------------------
# Obtain from X Developer Portal: https://developer.twitter.com/en/portal/dashboard
# Callback URL:
#   - https://luffy-2601-yottaflex-ai-app-rvlcha.streamlit.app
#   - http://127.0.0.1:8000/auth/x/callback (for REST API)
#   - http://localhost:8501 (for local Streamlit)
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
